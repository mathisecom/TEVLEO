
{% comment %}
  VELARO - CARROUSEL D'AVANTAGES
  PC : 3 cartes + aperçu
  Mobile : slider tactile
  Police Schibsted Grotesk
  Contenu modifiable dans Shopify
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<section
  id="velaro-difference-{{ section.id }}"
  class="velaro-difference"
  style="
    --vc-bg: {{ section.settings.background }};
    --vc-text: {{ section.settings.text_color }};
    --vc-muted: {{ section.settings.muted_color }};
    --vc-border: {{ section.settings.border_color }};
    --vc-icon: {{ section.settings.icon_color }};
    --vc-arrow-bg: {{ section.settings.arrow_background }};
    --vc-gap: {{ section.settings.card_gap }}px;
    --vc-card-width: {{ section.settings.desktop_card_width }}%;
    --vc-mobile-width: {{ section.settings.mobile_card_width }}%;
    --vc-card-height: {{ section.settings.card_height }}px;
    --vc-title-size: {{ section.settings.title_size }}px;
    --vc-top-padding: {{ section.settings.padding_top }}px;
    --vc-bottom-padding: {{ section.settings.padding_bottom }}px;
    --vc-heading-font: {% if section.settings.heading_font == 'serif' %}Georgia, 'Times New Roman', serif{% else %}'Schibsted Grotesk', sans-serif{% endif %};
  "
>

  <div class="velaro-difference__container">

    <!-- EN-TÊTE -->
    <div class="velaro-difference__heading">

      {% if section.settings.eyebrow != blank %}
        <p class="velaro-difference__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="velaro-difference__title">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

    </div>

    <!-- SLIDER -->
    <div class="velaro-difference__slider">

      <div
        class="velaro-difference__viewport"
        data-vc-viewport
        tabindex="0"
        aria-label="Carrousel des avantages"
      >

        <div class="velaro-difference__track">

          {% for block in section.blocks %}

            <article
              class="velaro-difference__card"
              data-vc-card
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >

              <!-- ICÔNE -->
              <div class="velaro-difference__icon">

                {% case block.settings.icon %}

                  {% when 'lock' %}

                    <svg viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true">
                      <rect x="5" y="10" width="14" height="11" rx="2"/>
                      <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
                    </svg>

                  {% when 'shield' %}

                    <svg viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true">
                      <path d="M12 2 20 6v6c0 5-3 8-8 10-5-2-8-5-8-10V6z"/>
                    </svg>

                  {% when 'wheels' %}

                    <svg viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true">
                      <path d="M4 6h12l4 6v5h-3"/>
                      <path d="M4 6v11h3"/>
                      <path d="M10 17h4"/>
                      <circle cx="8.5" cy="17" r="2"/>
                      <circle cx="16" cy="17" r="2"/>
                    </svg>

                  {% when 'send' %}

                    <svg viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true">
                      <path d="m22 2-7 20-4-9-9-4Z"/>
                      <path d="M22 2 11 13"/>
                    </svg>

                  {% when 'suitcase' %}

                    <svg viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true">
                      <rect x="4" y="7" width="16" height="14" rx="2"/>
                      <path d="M9 7V4h6v3"/>
                      <path d="M8 21v1M16 21v1"/>
                    </svg>

                  {% when 'check' %}

                    <svg viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="m8 12 3 3 5-6"/>
                    </svg>

                  {% when 'sparkles' %}

                    <svg viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true">
                      <path d="m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5Z"/>
                    </svg>

                {% endcase %}

              </div>

              <!-- TITRE -->
              {% if block.settings.title != blank %}
                <h3 class="velaro-difference__card-title">
                  {{ block.settings.title | escape }}
                </h3>
              {% endif %}

              <!-- DESCRIPTION -->
              {% if block.settings.description != blank %}
                <p class="velaro-difference__card-description">
                  {{ block.settings.description | escape }}
                </p>
              {% endif %}

            </article>

          {% endfor %}

        </div>

      </div>

      <!-- FLÈCHE PRÉCÉDENTE -->
      <button
        class="velaro-difference__arrow velaro-difference__arrow--prev"
        type="button"
        data-vc-prev
        aria-label="Avantages précédents"
      >
        <svg viewBox="0 0 24 24"
          fill="none" stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="m15 18-6-6 6-6"/>
        </svg>
      </button>

      <!-- FLÈCHE SUIVANTE -->
      <button
        class="velaro-difference__arrow velaro-difference__arrow--next"
        type="button"
        data-vc-next
        aria-label="Avantages suivants"
      >
        <svg viewBox="0 0 24 24"
          fill="none" stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>

    </div>

    <!-- PAGINATION AUTOMATIQUE -->
    <div
      class="velaro-difference__pagination"
      data-vc-pagination
      aria-label="Navigation du carrousel"
    ></div>

  </div>

</section>

<style>

/* =============================
   SECTION
============================= */

#velaro-difference-{{ section.id }} {
  width: 100%;
  max-width: 100%;

  margin: 0;
  padding:
    var(--vc-top-padding)
    20px
    var(--vc-bottom-padding);

  background: var(--vc-bg);
  color: var(--vc-text);

  font-family: 'Schibsted Grotesk', sans-serif !important;
  box-sizing: border-box;

  overflow: hidden;
}

#velaro-difference-{{ section.id }} *,
#velaro-difference-{{ section.id }} *::before,
#velaro-difference-{{ section.id }} *::after {
  box-sizing: border-box;
}

.velaro-difference__container {
  width: 100%;
  max-width: 1120px;
  margin: 0 auto;
}

/* =============================
   EN-TÊTE
============================= */

.velaro-difference__heading {
  text-align: center;
  margin: 0 0 34px;
}

.velaro-difference__eyebrow {
  font-family: 'Schibsted Grotesk', sans-serif !important;

  font-size: 12px;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2.5px;
  text-transform: uppercase;

  color: var(--vc-text);

  margin: 0 0 10px !important;
  padding: 0 !important;
}

.velaro-difference__title {
  font-family: var(--vc-heading-font) !important;

  font-size: var(--vc-title-size) !important;
  font-weight: 700 !important;
  line-height: 1.15 !important;
  letter-spacing: -0.8px;

  color: var(--vc-text) !important;

  margin: 0 !important;
  padding: 0 !important;

  text-transform: none !important;
}

/* =============================
   CONTENEUR SLIDER
============================= */

.velaro-difference__slider {
  position: relative;
  width: 100%;
}

.velaro-difference__viewport {
  width: 100%;
  overflow-x: auto;
  overflow-y: hidden;

  scrollbar-width: none;
  -ms-overflow-style: none;

  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  overscroll-behavior-x: contain;

  -webkit-overflow-scrolling: touch;
}

.velaro-difference__viewport::-webkit-scrollbar {
  display: none;
}

.velaro-difference__viewport:focus-visible {
  outline: 2px solid var(--vc-border);
  outline-offset: -2px;
}

/* =============================
   PISTE HORIZONTALE
============================= */

.velaro-difference__track {
  position: relative;

  display: flex;
  align-items: stretch;

  gap: var(--vc-gap);

  width: 100%;
  min-width: 100%;
}

/* =============================
   CARTES PC
============================= */

.velaro-difference__card {
  flex: 0 0 var(--vc-card-width);

  min-width: 0;
  min-height: var(--vc-card-height);

  padding: 24px 20px 22px;

  display: flex;
  flex-direction: column;
  align-items: flex-start;

  background: var(--vc-bg);
  color: var(--vc-text);

  border: 1px solid var(--vc-border);
  border-radius: 0;

  scroll-snap-align: start;
  scroll-snap-stop: always;
}

/* =============================
   ICÔNES
============================= */

.velaro-difference__icon {
  width: 29px;
  height: 29px;

  flex: 0 0 29px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 21px;

  color: var(--vc-icon);
}

.velaro-difference__icon svg {
  width: 27px;
  height: 27px;
  display: block;
}

/* =============================
   TITRE DES CARTES
============================= */

.velaro-difference__card-title {
  font-family: var(--vc-heading-font) !important;

  font-size: 20px !important;
  font-weight: 700 !important;
  line-height: 1.3 !important;

  letter-spacing: -0.2px;

  color: var(--vc-text) !important;

  margin: 0 0 10px !important;
  padding: 0 !important;

  text-transform: none !important;
  overflow-wrap: break-word;
}

/* =============================
   DESCRIPTIONS
============================= */

.velaro-difference__card-description {
  font-family: 'Schibsted Grotesk', sans-serif !important;

  font-size: 14px;
  font-weight: 400;
  line-height: 1.65;

  color: var(--vc-muted);

  margin: 0 !important;
  padding: 0 !important;

  overflow-wrap: break-word;
}

/* =============================
   FLÈCHES
============================= */

.velaro-difference__arrow {
  position: absolute;

  top: 50%;
  z-index: 5;

  width: 44px;
  height: 44px;

  display: flex;
  align-items: center;
  justify-content: center;

  transform: translateY(-50%);

  background: var(--vc-arrow-bg);
  color: var(--vc-text);

  border: 1px solid var(--vc-border);
  border-radius: 50%;

  padding: 0;
  margin: 0;

  cursor: pointer;

  transition:
    opacity .2s ease,
    background .2s ease;
}

.velaro-difference__arrow svg {
  display: block;
  width: 18px;
  height: 18px;
}

.velaro-difference__arrow--prev {
  left: -13px;
}

.velaro-difference__arrow--next {
  right: -13px;
}

.velaro-difference__arrow:hover:not(:disabled) {
  background: #F2F2F2;
}

.velaro-difference__arrow:disabled {
  opacity: .3;
  cursor: default;
}

.velaro-difference__arrow:focus-visible {
  outline: 2px solid var(--vc-text);
  outline-offset: 3px;
}

/* =============================
   PAGINATION
============================= */

.velaro-difference__pagination {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  min-height: 16px;
  margin-top: 17px;
}

.velaro-difference__dot {
  width: 7px;
  height: 7px;

  min-width: 7px;
  min-height: 7px;

  padding: 0;
  margin: 0;

  appearance: none;
  -webkit-appearance: none;

  border: 1px solid var(--vc-text);
  border-radius: 50%;

  background: transparent;
  cursor: pointer;

  transition:
    width .2s ease,
    background .2s ease;
}

.velaro-difference__dot.is-active {
  width: 24px;
  border-radius: 20px;
  background: var(--vc-text);
}

.velaro-difference__dot:focus-visible {
  outline: 2px solid var(--vc-text);
  outline-offset: 3px;
}

.velaro-difference__pagination[hidden],
.velaro-difference__arrow[hidden] {
  display: none !important;
}

/* =============================
   TABLETTE
============================= */

@media screen and (max-width: 990px) {

  .velaro-difference__heading {
    margin-bottom: 26px;
  }

  .velaro-difference__title {
    font-size: 32px !important;
  }

  .velaro-difference__card {
    flex-basis: 45%;
    padding: 22px 18px;
  }

  .velaro-difference__card-title {
    font-size: 19px !important;
  }

  .velaro-difference__card-description {
    font-size: 13px;
  }

}

/* =============================
   MOBILE
============================= */

@media screen and (max-width: 749px) {

  #velaro-difference-{{ section.id }} {
    padding:
      var(--vc-top-padding)
      16px
      var(--vc-bottom-padding);
  }

  .velaro-difference__heading {
    margin-bottom: 23px;
  }

  .velaro-difference__eyebrow {
    font-size: 10px;
    letter-spacing: 2px;
    margin-bottom: 9px !important;
  }

  .velaro-difference__title {
    font-size: 29px !important;
    letter-spacing: -0.5px;
  }

  /* SLIDER MOBILE */

  .velaro-difference__track {
    gap: 12px;
  }

  .velaro-difference__card {
    flex: 0 0 var(--vc-mobile-width);
    min-height: 190px;

    padding: 22px 20px 20px;
  }

  .velaro-difference__icon {
    width: 27px;
    height: 27px;
    flex-basis: 27px;

    margin-bottom: 19px;
  }

  .velaro-difference__icon svg {
    width: 25px;
    height: 25px;
  }

  .velaro-difference__card-title {
    font-size: 19px !important;
    margin-bottom: 9px !important;
  }

  .velaro-difference__card-description {
    font-size: 13px;
    line-height: 1.6;
  }

  /* FLÈCHES MOBILE */

  .velaro-difference__arrow {
    width: 35px;
    height: 35px;
  }

  .velaro-difference__arrow svg {
    width: 16px;
    height: 16px;
  }

  .velaro-difference__arrow--prev {
    left: -9px;
  }

  .velaro-difference__arrow--next {
    right: -9px;
  }

  /* POINTS MOBILE */

  .velaro-difference__pagination {
    margin-top: 17px;
  }

}

/* =============================
   PETITS MOBILES
============================= */

@media screen and (max-width: 390px) {

  .velaro-difference__title {
    font-size: 26px !important;
  }

  .velaro-difference__card {
    padding: 19px 17px;
  }

  .velaro-difference__card-title {
    font-size: 18px !important;
  }

  .velaro-difference__card-description {
    font-size: 12px;
  }

}

/* =============================
   ACCESSIBILITÉ
============================= */

@media (prefers-reduced-motion: reduce) {

  .velaro-difference__viewport {
    scroll-behavior: auto;
  }

  .velaro-difference__arrow,
  .velaro-difference__dot {
    transition: none;
  }

}

</style>

<script>
(function () {

  const sectionId = 'velaro-difference-{{ section.id }}';

  function initializeCarousel() {

    const root = document.getElementById(sectionId);

    if (!root || root.dataset.vcReady === 'true') {
      return;
    }

    const viewport = root.querySelector(
      '[data-vc-viewport]'
    );

    const cards = Array.from(
      root.querySelectorAll('[data-vc-card]')
    );

    const prevButton = root.querySelector(
      '[data-vc-prev]'
    );

    const nextButton = root.querySelector(
      '[data-vc-next]'
    );

    const pagination = root.querySelector(
      '[data-vc-pagination]'
    );

    if (
      !viewport ||
      !cards.length ||
      !prevButton ||
      !nextButton ||
      !pagination
    ) return;

    root.dataset.vcReady = 'true';

    let stops = [0];
    let activeIndex = 0;
    let frameRequested = false;

    /* ==========================
       POSITIONS DES SLIDES
    ========================== */

    function calculateStops() {

      const maxScroll = Math.max(
        0,
        viewport.scrollWidth - viewport.clientWidth
      );

      const firstOffset = cards[0].offsetLeft;

      const positions = cards.map(function(card) {

        return Math.max(
          0,
          Math.min(
            maxScroll,
            card.offsetLeft - firstOffset
          )
        );

      });

      positions.push(maxScroll);

      positions.sort(function(a, b) {
        return a - b;
      });

      stops = positions.filter(function(value, index, array) {

        return index === 0 ||
          Math.abs(value - array[index - 1]) > 3;

      });

      if (!stops.length) {
        stops = [0];
      }

    }

    /* ==========================
       PAGINATION DYNAMIQUE
    ========================== */

    function createPagination() {

      pagination.innerHTML = '';

      stops.forEach(function(position, index) {

        const dot = document.createElement('button');

        dot.type = 'button';
        dot.className = 'velaro-difference__dot';

        dot.setAttribute(
          'aria-label',
          'Afficher la position ' +
          (index + 1) +
          ' sur ' +
          stops.length
        );

        dot.addEventListener('click', function() {
          goTo(index);
        });

        pagination.appendChild(dot);

      });

      pagination.hidden = stops.length <= 1;
      prevButton.hidden = stops.length <= 1;
      nextButton.hidden = stops.length <= 1;

    }

    /* ==========================
       POSITION ACTIVE
    ========================== */

    function closestIndex() {

      let index = 0;
      let distance = Infinity;

      stops.forEach(function(stop, i) {

        const difference = Math.abs(
          viewport.scrollLeft - stop
        );

        if (difference < distance) {

          distance = difference;
          index = i;

        }

      });

      return index;

    }

    function updateNavigation() {

      activeIndex = closestIndex();

      const dots = pagination.querySelectorAll(
        '.velaro-difference__dot'
      );

      dots.forEach(function(dot, index) {

        const isActive = index === activeIndex;

        dot.classList.toggle(
          'is-active',
          isActive
        );

        if (isActive) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }

      });

      prevButton.disabled = activeIndex === 0;

      nextButton.disabled =
        activeIndex >= stops.length - 1;

    }

    /* ==========================
       DÉPLACEMENT
    ========================== */

    function goTo(index) {

      const target = Math.max(
        0,
        Math.min(index, stops.length - 1)
      );

      activeIndex = target;

      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      viewport.scrollTo({

        left: stops[target],

        behavior: reducedMotion ? 'instant' : 'smooth'

      });

    }

    /* ==========================
       FLÈCHES
    ========================== */

    prevButton.addEventListener('click', function() {

      goTo(closestIndex() - 1);

    });

    nextButton.addEventListener('click', function() {

      goTo(closestIndex() + 1);

    });

    /* ==========================
       DÉFILEMENT AU DOIGT
    ========================== */

    viewport.addEventListener(
      'scroll',
      function() {

        if (frameRequested) return;

        frameRequested = true;

        requestAnimationFrame(function() {

          updateNavigation();

          frameRequested = false;

        });

      },
      { passive: true }
    );

    /* ==========================
       REDIMENSIONNEMENT
    ========================== */

    function refreshCarousel() {

      calculateStops();

      createPagination();

      updateNavigation();

    }

    window.addEventListener(
      'resize',
      refreshCarousel
    );

    /* ==========================
       ÉDITEUR SHOPIFY
    ========================== */

    document.addEventListener(
      'shopify:block:select',
      function(event) {

        if (!event.detail || !event.detail.blockId) {
          return;
        }

        const selectedCard = cards.find(function(card) {

          return card.dataset.blockId === event.detail.blockId;

        });

        if (!selectedCard) return;

        const index = cards.indexOf(selectedCard);

        const position =
          selectedCard.offsetLeft -
          cards[0].offsetLeft;

        let nearest = 0;
        let distance = Infinity;

        stops.forEach(function(stop, i) {

          const difference = Math.abs(stop - position);

          if (difference < distance) {

            distance = difference;
            nearest = i;

          }

        });

        goTo(nearest);

      }
    );

    /* INITIALISATION */

    refreshCarousel();

  }

  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initializeCarousel
    );

  } else {

    initializeCarousel();

  }

  document.addEventListener(
    'shopify:section:load',
    initializeCarousel
  );

})();
</script>

{% schema %}
{
  "name": "Avantages en carrousel",
  "tag": "section",
  "class": "section-velaro-carousel",
  "settings": [
    {
      "type": "header",
      "content": "Titres"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "CE QUI FAIT LA DIFFÉRENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal",
      "default": "Pensées pour voyager"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Style des titres",
      "options": [
        {
          "value": "serif",
          "label": "Élégant avec empattements"
        },
        {
          "value": "sans",
          "label": "Schibsted Grotesk"
        }
      ],
      "default": "serif"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Taille du titre PC",
      "min": 26,
      "max": 54,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fond de section",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Titres",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Descriptions",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bordures",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icônes",
      "default": "#111111"
    },
